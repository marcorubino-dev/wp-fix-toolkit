{
  "name": "mws/wp-fix-toolkit",
  "description": "Controlled, auditable execution of WordPress maintenance and repair actions.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "MWS\\WPFixToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MWS\\WPFixToolkit\\Tests\\": "tests/",
      "MWS\\WPFixToolkit\\Examples\\": "examples/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
